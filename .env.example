# Скопируйте этот файл в .env и заполните значения. .env в git не попадает.
# Его читают и серверные скрипты, и docker compose.
PB_URL=http://localhost:8090

# Адрес PocketBase для браузера. По умолчанию не нужен: клиент берёт тот же источник,
# откуда пришла страница, и путь /api/pb/, который раздаёт nginx. Переменную задают только
# когда страница и база на разных источниках. В Docker-сборке .env исключён (файл в
# .dockerignore), значение задавать аргументом сборки.
# VITE_PB_URL=

# Логин и пароль PocketBase superuser (использует docker-up.bat с флагом --superuser)
PB_EMAIL=
PB_PASSWORD=

# Kinopoisk API — ключ для серверных скраперов
KINOPOISK_API_KEY=

# Poisk Kino API — ключ для серверных скраперов
POISK_KINO_API_KEY=

# Kodik API (https://kodikapi.com) — токен для получения embed-ссылки плеера.
# Используется только nginx-прокси /api/kodik/, в браузер не попадает.
KODIK_TOKEN=

# TMDB API — необязателен: без него блоки, использующие TMDB, остаются пустыми
TMDB_API_KEY=

# Shikimori API (scripts/scrape-anime.mjs): User-Agent с именем приложения — по правилам API
# без него адрес могут заблокировать. Лимиты: 5rps и 90rpm, поэтому в скрипте задержка 1200 мс.
SHIKIMORI_USER_AGENT=kinocrab-local/1.0

# Alloha API (https://api.alloha.tv) — токен подставляет nginx-прокси /api/alloha/,
# в браузер он не попадает. Если пусто, код делает одну попытку напрямую из браузера.
ALLOHA_TOKEN=
